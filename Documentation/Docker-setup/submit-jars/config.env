# Which cloud?
ENVIRONMENT=aws
# ENVIRONMENT=azure
# ENVIRONMENT=gcp
# ENVIRONMENT=oci
GITHUB_RELEASE_VERSION=release-3.1.0

############ AWS ############
AWS_BUCKET=BUCKET-PATH
AWS_REGION=YOUR_AWS_REGION
AWS_ACCESS_KEY=YOUR_AWS_KEY
AWS_SECRET_KEY=YOUR_AWS_SECRET


############ AZURE ############
AZURE_CONTAINER=flink-jars
AZURE_ACCOUNT=myazureaccount
AZURE_KEY=my_azure_key


############ GCP ############
GCP_BUCKET=gcp-flink-jars
GCP_CREDENTIALS=/path/to/gcp-service.json


############ OCI ############
OCI_BUCKET=oci-flink-jars
OCI_NAMESPACE=mytenantns
OCI_REGION=ap-mumbai-1
OCI_CONFIG=/home/user/.oci/config
